<?xml version="1.0" encoding="UTF-8"?>
<gddiDataDictionary xmlns="http://www.omg.org/gddi/data-dictionary">
    <typeBlock>
        <typeId>6</typeId>
        <typeName>AES Block</typeName>
        <majorVersion>1</majorVersion>
        <minorVersion>0</minorVersion>
        <description>This type is used to carry AES encrypted and decrypted data in the GDDI payload with corresponding AES metadata. These messages are typically transferred between FEP and AES Crypto applications.</description>
        <tagInfoArray>
            <tlv>
                <tagId>1</tagId>
                <tagName>Authentication Algorithm</tagName>
                <valueLength>1</valueLength>
                <valueType>octet</valueType>
                <valueUnits>enum</valueUnits>
                <description>The selected authentication algorithm: (0: HMAC, 1: CMAC, 2: GMAC, 3: GCM). (Default: 0)</description>
            </tlv>
            <tlv>
                <tagId>2</tagId>
                <tagName>Encryption Algorithm</tagName>
                <valueLength>1</valueLength>
                <valueType>octet</valueType>
                <valueUnits>enum</valueUnits>
                <description>The selected encryption algorithm: (0: GCM, 1: ECB, 2: CBC, 3: CFB, 4: OFB, 5: CTR). (Default: 0)</description>
            </tlv>
            <tlv>
                <tagId>3</tagId>
                <tagName>PT CT Length</tagName>
                <valueLength>4</valueLength>
                <valueType>unsigned long</valueType>
                <valueUnits>bytes</valueUnits>
                <description>Length of Plain Text (PT) data to encrypt or Cipher Text (CT) data to decrypt. If zero, everything from the 'PT CT Offset' to the end of the messsage is the length. (Default: 0)</description>
            </tlv>
            <tlv>
                <tagId>4</tagId>
                <tagName>PT CT Offset</tagName>
                <valueLength>4</valueLength>
                <valueType>unsigned long</valueType>
                <valueUnits>bytes</valueUnits>
                <description>Byte offset to where the data block to encrypt/decrypt begins. (Default: 0)</description>
            </tlv>
            <tlv>
                <tagId>5</tagId>
                <tagName>AAD Length</tagName>
                <valueLength>4</valueLength>
                <valueType>unsigned long</valueType>
                <valueUnits>bytes</valueUnits>
                <description>Length of Additional Authentication Data (AAD). If zero there is no AAD. (Default: 0)</description>
            </tlv>
            <tlv>
                <tagId>6</tagId>
                <tagName>AAD Offset</tagName>
                <valueLength>4</valueLength>
                <valueType>unsigned long</valueType>
                <valueUnits>bytes</valueUnits>
                <description>Byte offset to where the AAD data block begins. Data block can also be a part of the preamble. (Default: 0)</description>
            </tlv>
            <tlv>
                <tagId>7</tagId>
                <tagName>Preamble Length</tagName>
                <valueLength>4</valueLength>
                <valueType>unsigned long</valueType>
                <valueUnits>bytes</valueUnits>
                <description>Length of any preamble data. If zero there is no preamble. (Default: 0)</description>
            </tlv>
            <tlv>
                <tagId>8</tagId>
                <tagName>Preamble Offset</tagName>
                <valueLength>4</valueLength>
                <valueType>unsigned long</valueType>
                <valueUnits>bytes</valueUnits>
                <description>Byte offset to where the preamble data block begins. (Default: 0)</description>
            </tlv>
            <tlv>
                <tagId>9</tagId>
                <tagName>Postamble Length</tagName>
                <valueLength>4</valueLength>
                <valueType>unsigned long</valueType>
                <valueUnits>bytes</valueUnits>
                <description>Length of any postamble data. If zero there is no postamble. (Default: 0)</description>
            </tlv>
            <tlv>
                <tagId>10</tagId>
                <tagName>Postamble Offset</tagName>
                <valueLength>4</valueLength>
                <valueType>unsigned long</valueType>
                <valueUnits>bytes</valueUnits>
                <description>Byte offset to where the postamble data block begins. (Default: 0)</description>
            </tlv>
            <tlv>
                <tagId>11</tagId>
                <tagName>Authentication Key Index</tagName>
                <valueLength>4</valueLength>
                <valueType>unsigned long</valueType>
                <valueUnits>index</valueUnits>
                <description>The two byte key index used for authentication. Typically set to the same value as the 'Encrypt Key Index'. (Default: 0)</description>
            </tlv>
            <tlv>
                <tagId>12</tagId>
                <tagName>Authentication Key Length</tagName>
                <valueLength>2</valueLength>
                <valueType>unsigned short</valueType>
                <valueUnits>bytes</valueUnits>
                <description>Length in bytes of the Authentication Key. Typically set to the same value as the 'Encrypt Key Length'. (Default: 0)</description>
            </tlv>
            <tlv>
                <tagId>13</tagId>
                <tagName>Encrypt Key Index</tagName>
                <valueLength>4</valueLength>
                <valueType>unsigned long</valueType>
                <valueUnits>index</valueUnits>
                <description>The two byte Key Index used for encryption/decryption. (Default: 0)</description>
            </tlv>
            <tlv>
                <tagId>14</tagId>
                <tagName>Encrypt Key Length</tagName>
                <valueLength>4</valueLength>
                <valueType>unsigned long</valueType>
                <valueUnits>bytes</valueUnits>
                <description>Length of the Encryption/Decryption Key. (Default: 0)</description>
            </tlv>
            <tlv>
                <tagId>15</tagId>
                <tagName>IV Source</tagName>
                <valueLength>1</valueLength>
                <valueType>octet</valueType>
                <valueUnits>enum</valueUnits>
                <description>Where the Initialization Vector (IV) is sourced: (0: InputData - Uses 'IV Offset' and 'IV Length'), 1: Random - Send randomized IV of size 'IV Length'). (Default: 1)</description>
            </tlv>
            <tlv>
                <tagId>16</tagId>
                <tagName>IV Length</tagName>
                <valueLength>2</valueLength>
                <valueType>unsigned short</valueType>
                <valueUnits>bytes</valueUnits>
                <description>The length of the Initialization Vector (IV). (Default: 0)</description>
            </tlv>
            <tlv>
                <tagId>17</tagId>
                <tagName>IV Offset</tagName>
                <valueLength>4</valueLength>
                <valueType>unsigned long</valueType>
                <valueUnits>bytes</valueUnits>
                <description>The byte offset of the Initialization Vector (IV) - used with inputData. (Default: 0)</description>
            </tlv>
            <tlv>
                <tagId>18</tagId>
                <tagName>MAC Length</tagName>
                <valueLength>2</valueLength>
                <valueType>unsigned short</valueType>
                <valueUnits>bytes</valueUnits>
                <description>The length of the Message Authentication Code (MAC). (Default: 0)</description>
            </tlv>
            <tlv>
                <tagId>19</tagId>
                <tagName>MAC Present</tagName>
                <valueLength>1</valueLength>
                <valueType>boolean</valueType>
                <valueUnits>true/false</valueUnits>
                <description>If the MAC field is already appended to the data. If true it is assumed to be zeroized but data will be overwritten regardless. (Default: false)</description>
            </tlv>
            <tlv>
                <tagId>20</tagId>
                <tagName>Timestamp Seconds</tagName>
                <valueLength>4</valueLength>
                <valueType>unsigned long</valueType>
                <valueUnits>seconds</valueUnits>
                <description>Timestamp of raw data receipt, representing the number of non-leap seconds that have elapsed since 00:00:00 UTC on 1 January 1970. (Default: 0)</description>
            </tlv>
            <tlv>
                <tagId>21</tagId>
                <tagName>Timestamp Picoseconds</tagName>
                <valueLength>8</valueLength>
                <valueType>unsigned long long</valueType>
                <valueUnits>picoseconds</valueUnits>
                <description>The number of picoseconds representing the fractional portion of the 'Timestamp Seconds' metadata. (Default: 0)</description>
            </tlv>
        </tagInfoArray>
    </typeBlock>
</gddiDataDictionary>
