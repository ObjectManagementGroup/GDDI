<?xml version="1.0" encoding="UTF-8"?>
<gddiDataDictionary xmlns="http://www.omg.org/gddi/data-dictionary">
    <typeBlock>
        <typeId>14</typeId>
        <typeName>Range Data</typeName>
        <majorVersion>1</majorVersion>
        <minorVersion>0</minorVersion>
        <description>This GDDI type is used to carry metadata describing the range bewteen the earth and space vehicle.</description>
        <tagInfoArray>
            <tlv>
                <tagId>1</tagId>
                <tagName>Two Way Range</tagName>
                <valueLength>8</valueLength>
                <valueType>double</valueType>
                <valueUnits>nanoseconds</valueUnits>
                <description>The two-way range value in nanoseconds. (Default: 0.0)</description>
            </tlv>
            <tlv>
                <tagId>2</tagId>
                <tagName>Range Rate</tagName>
                <valueLength>8</valueLength>
                <valueType>double</valueType>
                <valueUnits>nsec/sec</valueUnits>
                <description>The range rate in nanoseconds per second. (Default: 0.0)</description>
            </tlv>
            <tlv>
                <tagId>3</tagId>
                <tagName>Doppler</tagName>
                <valueLength>8</valueLength>
                <valueType>double</valueType>
                <valueUnits>Hz</valueUnits>
                <description>The time-correlated Doppler value. (Default: 0.0)</description>
            </tlv>
            <tlv>
                <tagId>4</tagId>
                <tagName>Range Quality</tagName>
                <valueLength>1</valueLength>
                <valueType>octet</valueType>
                <valueUnits>percentage</valueUnits>
                <description>The quality of the range measurement (0 - 100%). (Default: 0)</description>
            </tlv>
            <tlv>
                <tagId>5</tagId>
                <tagName>Timestamp Seconds</tagName>
                <valueLength>4</valueLength>
                <valueType>unsigned long</valueType>
                <valueUnits>seconds</valueUnits>
                <description>Time of the ranging measurement. This represents the number of non-leap seconds elapsed since 00:00:00 UTC on 1 January 1970. (Default: 0)</description>
            </tlv>
            <tlv>
                <tagId>6</tagId>
                <tagName>Timestamp Picoseconds</tagName>
                <valueLength>8</valueLength>
                <valueType>unsigned long long</valueType>
                <valueUnits>picoseconds</valueUnits>
                <description>The number of picoseconds representing the fractional portion of the 'Timestamp Seconds' metadata. (Default: 0)</description>
            </tlv>
        </tagInfoArray>
    </typeBlock>
</gddiDataDictionary>
